---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BotonWhatsApp from '../../componentes/BotonWhatsApp.astro';

export async function getStaticPaths() {
  const articulos = (await getCollection('blog')).filter((a) => !a.data.borrador);
  return articulos.map((articulo) => ({
    params: { slug: articulo.id },
    props: {
      articulo,
      otros: articulos.filter((a) => a.id !== articulo.id).slice(0, 3),
    },
  }));
}

const { articulo, otros } = Astro.props;
const { Content, headings } = await render(articulo);
const d = articulo.data;

const fecha = (f) =>
  new Intl.DateTimeFormat('es-CO', { day: 'numeric', month: 'long', year: 'numeric' }).format(f);

const url = `https://asesoriasas.com/blog/${articulo.id}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: d.titulo,
      description: d.descripcion,
      datePublished: d.fecha.toISOString(),
      dateModified: (d.actualizado || d.fecha).toISOString(),
      inLanguage: 'es-CO',
      mainEntityOfPage: url,
      author: { '@type': 'Organization', name: 'Asesorías Seguridad Social SAS' },
      publisher: {
        '@type': 'Organization',
        name: 'Asesorías Seguridad Social SAS',
        url: 'https://asesoriasas.com/',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://asesoriasas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://asesoriasas.com/blog/' },
        { '@type': 'ListItem', position: 3, name: d.titulo },
      ],
    },
  ],
};
---
<Base titulo={d.tituloSeo + ' | Asesorías SAS'} descripcion={d.descripcion} ruta={`/blog/${articulo.id}/`} jsonLd={jsonLd}>
  <article>
    <header class="art-cab">
      <div class="contenedor">
        <nav class="miga" aria-label="Ruta de navegación">
          <a href="/">Inicio</a> <span aria-hidden="true">/</span>
          <a href="/blog/">Blog</a> <span aria-hidden="true">/</span>
          <span aria-current="page">{d.titulo}</span>
        </nav>
        <span class="art-cat">{d.categoria}</span>
        <h1>{d.titulo}</h1>
        <p class="art-fecha">
          <time datetime={d.fecha.toISOString()}>{fecha(d.fecha)}</time>
          {d.actualizado && <> · actualizado el {fecha(d.actualizado)}</>}
        </p>
      </div>
    </header>

    <div class="contenedor art-cuerpo">
      {headings.length > 2 && (
        <nav class="art-indice" aria-label="Contenido del artículo">
          <h2>En este artículo</h2>
          <ul>
            {headings.filter((h) => h.depth === 2).map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prosa">
        <Content />
      </div>
    </div>
  </article>

  <section class="seccion art-cta">
    <div class="contenedor art-cta__in">
      <div>
        <h2>¿Te lo gestionamos?</h2>
        <p>Afiliaciones y planilla mensual en toda Colombia, sin que tengas que ocuparte.</p>
      </div>
      <BotonWhatsApp mensaje={`Hola, leí el artículo sobre ${d.titulo}`}>
        Escribir por WhatsApp
      </BotonWhatsApp>
    </div>
  </section>

  {otros.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <h2>Sigue leyendo</h2>
        <ul class="art-otros">
          {otros.map((a) => (
            <li>
              <a href={`/blog/${a.id}/`}>
                <strong>{a.data.titulo}</strong>
                <span>{a.data.descripcion}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style is:global>
  .art-cab {
    background: var(--azul-tinta);
    color: var(--papel);
    padding-block: var(--e-8) var(--e-12);
  }
  .art-cab .miga { font-size: var(--t-xs); color: rgba(245,241,232,.55); margin-bottom: var(--e-6); }
  .art-cab .miga a { color: rgba(245,241,232,.78); text-decoration: none; }
  .art-cat {
    display: inline-block; font-size: var(--t-xs); font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--dorado-claro); margin-bottom: var(--e-3);
  }
  .art-cab h1 { max-width: 24ch; text-shadow: 0 1px 2px rgba(4,16,32,.32); }
  .art-fecha { font-size: var(--t-sm); color: rgba(245,241,232,.58); margin-top: var(--e-3); }

  .art-cuerpo { padding-block: var(--e-12); display: grid; gap: var(--e-8); }

  .art-indice {
    border-left: 2px solid var(--dorado);
    padding-left: var(--e-4);
    max-width: 62ch;
  }
  .art-indice h2 {
    font-family: var(--fuente-texto);
    font-size: var(--t-xs); font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--tinta-tenue); margin-bottom: var(--e-2);
  }
  .art-indice ul { list-style: none; display: grid; gap: 4px; }
  .art-indice a { font-size: var(--t-sm); color: var(--azul-medio); text-decoration: none; }
  .art-indice a:hover { text-decoration: underline; }

  /* Ritmo de lectura: medida corta y jerarquia clara. */
  .prosa { max-width: 68ch; }
  .prosa h2 {
    font-size: var(--t-lg);
    margin-top: var(--e-12); margin-bottom: var(--e-3);
    padding-top: var(--e-4); border-top: 1px solid var(--linea);
    scroll-margin-top: var(--e-8);
  }
  .prosa h3 { font-size: var(--t-md); margin-top: var(--e-6); margin-bottom: var(--e-2); }
  .prosa p { margin-bottom: var(--e-4); color: var(--tinta-suave); }
  .prosa ul, .prosa ol { margin: 0 0 var(--e-4) var(--e-6); color: var(--tinta-suave); }
  .prosa li { margin-bottom: var(--e-2); }
  .prosa strong { color: var(--tinta); }
  .prosa a { color: var(--azul-medio); }
  .prosa hr { border: none; border-top: 1px solid var(--linea); margin-block: var(--e-8); }

  .prosa table {
    width: 100%; border-collapse: collapse;
    margin-bottom: var(--e-6); font-size: var(--t-sm);
  }
  .prosa th, .prosa td {
    text-align: left; padding: var(--e-3);
    border-bottom: 1px solid var(--linea);
  }
  .prosa th { font-weight: 600; color: var(--tinta); background: var(--papel-puro); }
  .prosa td { color: var(--tinta-suave); }
  .prosa td:last-child, .prosa th:last-child { text-align: right; font-variant-numeric: tabular-nums; }

  .art-cta { background: var(--azul-tinta); color: var(--papel); }
  .art-cta__in {
    display: flex; justify-content: space-between; align-items: center;
    gap: var(--e-6); flex-wrap: wrap;
  }
  .art-cta p { font-size: var(--t-sm); color: rgba(245,241,232,.76); margin-top: var(--e-2); }

  .art-otros { list-style: none; display: grid; gap: var(--e-3); margin-top: var(--e-6); }
  .art-otros a {
    display: grid; gap: 3px; padding: var(--e-4) var(--e-6);
    border: 1px solid var(--linea); border-radius: var(--radio);
    text-decoration: none; background: var(--papel-puro);
    transition: border-color .2s ease, transform .3s cubic-bezier(.22,.78,.3,1);
  }
  .art-otros a:hover { border-color: var(--dorado); transform: translateX(3px); }
  .art-otros strong { font-size: var(--t-sm); }
  .art-otros span { font-size: var(--t-xs); color: var(--tinta-suave); }
</style>
