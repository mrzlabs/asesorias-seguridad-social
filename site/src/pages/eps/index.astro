---
import Base from '../../layouts/Base.astro';
import { obtenerEps } from '../../datos/eps.js';

const { eps, ciudades } = await obtenerEps();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://asesoriasas.com/' },
    { '@type': 'ListItem', position: 2, name: 'Comparador de EPS' },
  ],
};
---
<Base
  titulo="Comparador de EPS por ciudad en Colombia | Asesorías SAS"
  descripcion="Compara las EPS disponibles en tu ciudad: cobertura, red de atención y particularidades. Información clara para elegir o trasladarte con confianza."
  ruta="/eps/"
  jsonLd={jsonLd}
>
  <section class="portada-eps">
    <div class="contenedor">
      <nav class="miga" aria-label="Ruta de navegación">
        <a href="/">Inicio</a> <span aria-hidden="true">/</span>
        <span aria-current="page">Comparador de EPS</span>
      </nav>
      <h1>Compara las EPS de tu ciudad</h1>
      <p class="entrada">
        Elegir EPS o trasladarte es una decisión que depende de dónde vives: no todas
        operan igual en cada ciudad. Reunimos la cobertura y la red de atención para que
        compares con datos, no con suposiciones.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <h2>Ciudades disponibles</h2>
      {ciudades.length > 0 ? (
        <ul class="rejilla-ciudades">
          {ciudades.map((c) => (
            <li>
              <a href={`/eps/${c.slug}/`}>
                <strong>{c.nombre}</strong>
                {c.departamento && <span>{c.departamento}</span>}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="cuerpo">
          Estamos preparando la información ciudad por ciudad, verificada contra fuentes
          oficiales. Muy pronto podrás comparar aquí.
        </p>
      )}
    </div>
  </section>

  {eps.length > 0 && (
    <section class="seccion eps-cat">
      <div class="contenedor">
        <h2>EPS del régimen contributivo</h2>
        <ul class="rejilla-eps">
          {eps.map((e) => (
            <li>
              <strong>{e.nombre}</strong>
              {e.sitio_web && <a href={e.sitio_web} rel="nofollow noopener" target="_blank">Sitio oficial</a>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <nav class="salida" aria-label="Continuar navegando">
    <div class="contenedor salida__in">
      <a href="/" class="salida__volver"><span aria-hidden="true">←</span> Ir al inicio</a>
      <a href="/servicios/" class="salida__inicio">Ver servicios</a>
    </div>
  </nav>
</Base>

<style>
  .portada-eps { background: var(--azul-tinta); color: var(--papel); padding-block: var(--e-8) var(--e-16); }
  .miga { font-size: var(--t-xs); color: rgba(245, 241, 232, .55); margin-bottom: var(--e-8); }
  .miga a { color: rgba(245, 241, 232, .78); text-decoration: none; }
  .miga a:hover { color: var(--dorado-claro); }
  .portada-eps h1 { max-width: 20ch; }
  .entrada { font-size: var(--t-lg); color: rgba(245, 241, 232, .78); max-width: 56ch; margin-top: var(--e-4); }
  .cuerpo { font-size: var(--t-md); color: var(--tinta-suave); max-width: 60ch; margin-top: var(--e-4); }
  .rejilla-ciudades { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--e-4); margin-top: var(--e-6); }
  .rejilla-ciudades a { display: grid; gap: var(--e-1); padding: var(--e-5) var(--e-6); border: 1px solid var(--linea); border-radius: var(--radio); text-decoration: none; background: var(--papel); transition: border-color .18s ease, background-color .18s ease; }
  .rejilla-ciudades a:hover { border-color: var(--dorado); background: var(--dorado-tenue); }
  .rejilla-ciudades strong { font-size: var(--t-md); color: var(--azul-tinta); }
  .rejilla-ciudades span { font-size: var(--t-xs); color: var(--tinta-suave); }
  .eps-cat { background: var(--papel-puro); }
  .rejilla-eps { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--e-3); margin-top: var(--e-6); }
  .rejilla-eps li { display: flex; justify-content: space-between; align-items: center; gap: var(--e-3); padding: var(--e-3) var(--e-4); border: 1px solid var(--linea); border-radius: var(--radio); background: var(--papel); }
  .rejilla-eps strong { font-size: var(--t-sm); }
  .rejilla-eps a { font-size: var(--t-xs); color: var(--azul-medio); }
  .salida { background: var(--papel-puro); border-top: 1px solid var(--linea); }
  .salida__in { display: flex; justify-content: space-between; align-items: center; gap: var(--e-4); flex-wrap: wrap; padding-block: var(--e-6); }
  .salida a { font-size: var(--t-sm); font-weight: 600; text-decoration: none; }
  .salida__volver { display: inline-flex; align-items: center; gap: var(--e-2); color: var(--azul-medio); }
  .salida__volver span { transition: transform .28s cubic-bezier(.22,.78,.3,1); }
  .salida__volver:hover span { transform: translateX(-4px); }
  .salida__inicio { color: var(--tinta-tenue); }
</style>
