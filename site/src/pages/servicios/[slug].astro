---
import Base from '../../layouts/Base.astro';
import BotonWhatsApp from '../../componentes/BotonWhatsApp.astro';
import FormularioLead from '../../componentes/FormularioLead.astro';
import { SERVICIOS } from '../../datos/servicios.js';
import { obtenerContenido } from '../../datos/api.js';

export async function getStaticPaths() {
  const datos = await obtenerContenido();
  const faq = (datos.faq || []).filter((f) => f.activo);

  return SERVICIOS.map((servicio) => ({
    params: { slug: servicio.slug },
    props: {
      servicio,
      detalle: (datos.servicios || []).find((s) => s.slug === servicio.slug) || null,
      faq,
    },
  }));
}

const { servicio, detalle, faq } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: servicio.titulo,
      description: servicio.descripcionSeo,
      areaServed: { '@type': 'Country', name: 'Colombia' },
      provider: {
        '@type': 'LocalBusiness',
        name: 'Asesorías Seguridad Social SAS',
        url: 'https://asesoriasas.com/',
        telephone: '+573204060607',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://asesoriasas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://asesoriasas.com/servicios/' },
        { '@type': 'ListItem', position: 3, name: servicio.titulo },
      ],
    },
    ...(faq.length
      ? [{
          '@type': 'FAQPage',
          mainEntity: faq.slice(0, 6).map((f) => ({
            '@type': 'Question',
            name: f.pregunta,
            acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
          })),
        }]
      : []),
  ],
};
---
<Base
  titulo={servicio.tituloSeo}
  descripcion={servicio.descripcionSeo}
  ruta={`/servicios/${servicio.slug}/`}
  jsonLd={jsonLd}
>
  <section class="cabecera-servicio">
    <div class="contenedor">
      <nav class="miga" aria-label="Ruta de navegación">
        <a href="/">Inicio</a> <span aria-hidden="true">/</span>
        <a href="/servicios/">Servicios</a> <span aria-hidden="true">/</span>
        <span aria-current="page">{servicio.titulo}</span>
      </nav>

      <h1>{servicio.titulo}</h1>
      <p class="entrada">{servicio.entrada}</p>

      <BotonWhatsApp mensaje={`Hola, me interesa: ${servicio.titulo}`} slug={servicio.slug}>
        Cotizar por WhatsApp
      </BotonWhatsApp>
    </div>
  </section>

  {detalle?.descripcion_corta && (
    <section class="seccion">
      <div class="contenedor">
        <h2>Qué incluye</h2>
        <p class="cuerpo">{detalle.descripcion_corta}</p>
      </div>
    </section>
  )}

  {faq.length > 0 && (
    <section class="seccion" id="preguntas">
      <div class="contenedor">
        <h2>Preguntas frecuentes</h2>
        <div class="acordeon">
          {faq.map((f) => (
            <details>
              <summary>{f.pregunta}</summary>
              <p>{f.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="seccion contacto" id="contacto">
    <div class="contenedor contacto__in">
      <div>
        <h2>Solicita {servicio.titulo.toLowerCase()}</h2>
        <p class="contacto__texto">
          Déjanos tus datos y te contactamos en menos de 24 horas hábiles.
        </p>
        <BotonWhatsApp
          variante="contorno"
          mensaje={`Hola, me interesa: ${servicio.titulo}`}
          slug={servicio.slug}
        >
          Escribir por WhatsApp
        </BotonWhatsApp>
      </div>
      <FormularioLead servicioPreseleccionado={servicio.slug} />
    </div>
  </section>
</Base>

<style>
  .cabecera-servicio {
    background: var(--azul-tinta);
    color: var(--papel);
    padding-block: var(--e-12) var(--e-16);
  }
  .miga {
    font-size: var(--t-xs);
    color: rgba(245, 241, 232, .58);
    margin-bottom: var(--e-6);
  }
  .miga a { color: rgba(245, 241, 232, .78); text-decoration: none; }
  .miga a:hover { color: var(--dorado-claro); }

  .cabecera-servicio h1 { max-width: 18ch; margin-bottom: var(--e-4); }
  .entrada {
    font-size: var(--t-lg);
    color: rgba(245, 241, 232, .76);
    max-width: 56ch;
    margin-bottom: var(--e-8);
    line-height: 1.55;
  }

  .cuerpo { font-size: var(--t-md); color: var(--tinta-suave); margin-top: var(--e-4); }

  .acordeon { margin-top: var(--e-6); max-width: 760px; }
  .acordeon details {
    border-bottom: 1px solid var(--linea);
    padding-block: var(--e-4);
  }
  .acordeon summary {
    font-weight: 600;
    font-size: var(--t-sm);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: var(--e-4);
  }
  .acordeon summary::-webkit-details-marker { display: none; }
  .acordeon summary::after {
    content: '+';
    color: var(--dorado);
    font-size: 1.3em;
    line-height: 1;
    flex-shrink: 0;
  }
  .acordeon details[open] summary::after { content: '−'; }
  .acordeon details p {
    margin-top: var(--e-3);
    font-size: var(--t-sm);
    color: var(--tinta-suave);
  }

  .contacto { background: var(--azul-tinta); color: var(--papel); }
  .contacto__in {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: var(--e-12);
    align-items: start;
  }
  .contacto__texto {
    font-size: var(--t-md);
    color: rgba(245, 241, 232, .76);
    max-width: 40ch;
    margin-block: var(--e-4) var(--e-6);
  }

  @media (max-width: 860px) {
    .contacto__in { grid-template-columns: 1fr; gap: var(--e-8); }
  }
</style>
