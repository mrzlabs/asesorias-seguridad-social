---
import Base from '../../layouts/Base.astro';
import BotonWhatsApp from '../../componentes/BotonWhatsApp.astro';
import FormularioLead from '../../componentes/FormularioLead.astro';
import { obtenerServicios, metaDeServicio, etiquetaCategoria } from '../../datos/servicios.js';
import { obtenerContenido } from '../../datos/api.js';

export async function getStaticPaths() {
  const servicios = await obtenerServicios();
  const datos = await obtenerContenido();
  const faq = (datos.faq || []).filter((f) => f.activo);

  return servicios.map((servicio) => ({
    params: { slug: servicio.slug },
    props: {
      servicio,
      // Servicios de la misma categoria, para navegacion cruzada.
      relacionados: servicios
        .filter((s) => s.categoria === servicio.categoria && s.slug !== servicio.slug)
        .slice(0, 4),
      faq,
    },
  }));
}

const { servicio, relacionados, faq } = Astro.props;
const meta = metaDeServicio(servicio);
const categoria = etiquetaCategoria(servicio.categoria);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: servicio.nombre,
      description: servicio.descripcion_larga || servicio.descripcion_corta,
      serviceType: categoria,
      areaServed: { '@type': 'Country', name: 'Colombia' },
      provider: {
        '@type': 'LocalBusiness',
        name: 'Asesorías Seguridad Social SAS',
        url: 'https://asesoriasas.com/',
        telephone: '+573204060607',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://asesoriasas.com/' },
        { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://asesoriasas.com/servicios/' },
        { '@type': 'ListItem', position: 3, name: servicio.nombre },
      ],
    },
    ...(faq.length
      ? [{
          '@type': 'FAQPage',
          mainEntity: faq.slice(0, 6).map((f) => ({
            '@type': 'Question',
            name: f.pregunta,
            acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
          })),
        }]
      : []),
  ],
};
---
<Base
  titulo={meta.titulo}
  descripcion={meta.descripcion}
  ruta={`/servicios/${servicio.slug}/`}
  jsonLd={jsonLd}
  
>
  <section class="portada-servicio">
    <div class="contenedor">
      <nav class="miga" aria-label="Ruta de navegación">
        <a href="/">Inicio</a> <span aria-hidden="true">/</span>
        <a href="/servicios/">Servicios</a> <span aria-hidden="true">/</span>
        <span aria-current="page">{servicio.nombre}</span>
      </nav>

      <span class="etiqueta-cat">{categoria}</span>
      <h1>{servicio.nombre}</h1>
      {servicio.descripcion_corta && <p class="entrada">{servicio.descripcion_corta}</p>}

      <div class="portada-servicio__acciones">
        <BotonWhatsApp mensaje={`Hola, me interesa: ${servicio.nombre}`} slug={servicio.slug}>
          Cotizar por WhatsApp
        </BotonWhatsApp>
        <a class="boton boton--contorno" href="#contacto">Dejar mis datos</a>
      </div>
    </div>
  </section>

  {servicio.descripcion_larga && (
    <section class="seccion">
      <div class="contenedor">
        <h2>En qué consiste</h2>
        <p class="cuerpo">{servicio.descripcion_larga}</p>
      </div>
    </section>
  )}

  {relacionados.length > 0 && (
    <section class="seccion relacionados">
      <div class="contenedor">
        <h2>También en {categoria.toLowerCase()}</h2>
        <ul class="rejilla-rel">
          {relacionados.map((s) => (
            <li>
              <a href={`/servicios/${s.slug}/`}>
                <strong>{s.nombre}</strong>
                <span>{s.descripcion_corta}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="seccion contacto" id="contacto">
    <div class="contenedor contacto__in">
      <div>
        <h2>Solicita {servicio.nombre.toLowerCase()}</h2>
        <p class="contacto__texto">
          Déjanos tus datos y te contactamos en menos de 24 horas hábiles.
        </p>
      </div>
      <FormularioLead servicioPreseleccionado={servicio.slug} />
    </div>
  </section>

  <!-- Salida explicita: sin esto se entra a un servicio y no hay camino
       de vuelta salvo el boton del navegador. -->
  <nav class="salida" aria-label="Continuar navegando">
    <div class="contenedor salida__in">
      <a href="/servicios/" class="salida__volver">
        <span aria-hidden="true">←</span> Ver todos los servicios
      </a>
      <a href="/" class="salida__inicio">Ir al inicio</a>
    </div>
  </nav>
</Base>

<style>
  .portada-servicio {
    background: var(--azul-tinta);
    color: var(--papel);
    padding-block: var(--e-8) var(--e-16);
  }
  .miga { font-size: var(--t-xs); color: rgba(245, 241, 232, .55); margin-bottom: var(--e-8); }
  .miga a { color: rgba(245, 241, 232, .78); text-decoration: none; }
  .miga a:hover { color: var(--dorado-claro); }

  .etiqueta-cat {
    display: inline-block;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--dorado-claro);
    margin-bottom: var(--e-3);
  }
  .portada-servicio h1 { max-width: 18ch; }
  .entrada {
    font-size: var(--t-lg);
    color: rgba(245, 241, 232, .78);
    max-width: 54ch;
    margin-block: var(--e-4) var(--e-8);
  }
  .portada-servicio__acciones { display: flex; gap: var(--e-3); flex-wrap: wrap; }

  .cuerpo { font-size: var(--t-md); color: var(--tinta-suave); margin-top: var(--e-4); max-width: 68ch; }

  .relacionados { background: var(--papel-puro); }
  .rejilla-rel {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--e-4);
    margin-top: var(--e-6);
  }
  .rejilla-rel a {
    display: grid;
    gap: var(--e-1);
    padding: var(--e-4) var(--e-6);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    text-decoration: none;
    background: var(--papel);
    height: 100%;
    transition: border-color .18s ease, background-color .18s ease;
  }
  .rejilla-rel a:hover { border-color: var(--dorado); background: var(--dorado-tenue); }
  .rejilla-rel strong { font-size: var(--t-sm); }
  .rejilla-rel span { font-size: var(--t-xs); color: var(--tinta-suave); }

  .contacto { background: var(--azul-tinta); color: var(--papel); }
  .contacto__in {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: var(--e-12);
    align-items: start;
  }
  .contacto__texto {
    font-size: var(--t-md);
    color: rgba(245, 241, 232, .76);
    max-width: 40ch;
    margin-top: var(--e-4);
  }

  .salida { background: var(--papel-puro); border-top: 1px solid var(--linea); }
  .salida__in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--e-4);
    flex-wrap: wrap;
    padding-block: var(--e-6);
  }
  .salida a { font-size: var(--t-sm); font-weight: 600; text-decoration: none; }
  .salida__volver {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    color: var(--azul-medio);
  }
  /* La flecha se desplaza al pasar el cursor: refuerza la direccion. */
  .salida__volver span { transition: transform .28s cubic-bezier(.22,.78,.3,1); }
  .salida__volver:hover span { transform: translateX(-4px); }
  .salida__volver:hover { color: var(--azul-tinta); }
  .salida__inicio { color: var(--tinta-tenue); }
  .salida__inicio:hover { color: var(--azul-medio); }

  @media (max-width: 860px) {
    .contacto__in { grid-template-columns: 1fr; gap: var(--e-8); }
  }
</style>
