---
import Base from '../../layouts/Base.astro';
import { serviciosPorCategoria, obtenerServicios } from '../../datos/servicios.js';
import Icono from '../../componentes/Icono.astro';

const grupos = await serviciosPorCategoria();
const total = (await obtenerServicios()).length;
---
<Base
  titulo="Servicios de seguridad social y seguros | Asesorías SAS"
  descripcion={`${total} servicios: afiliación a EPS, ARL, pensión y caja, seguros, SOAT, PAC y trámites. Para independientes y empresas en toda Colombia.`}
  ruta="/servicios/"
>
  <section class="cabecera">
    <div class="contenedor">
      <h1>Servicios</h1>
      <p class="entrada">
        {total} trámites y coberturas gestionados de principio a fin.
        Elige el que necesitas y te contamos cómo funciona.
      </p>

      <nav class="atajos" aria-label="Categorías">
        {grupos.map((g) => (
          <a href={`#${g.clave}`}>{g.etiqueta} <span>{g.servicios.length}</span></a>
        ))}
      </nav>
    </div>
  </section>

  {grupos.map((g) => (
    <section class="seccion grupo" id={g.clave} data-cat={g.clave}>
      <div class="contenedor">
        <h2>{g.etiqueta}</h2>
        <ul class="rejilla aparece aparece--escalonado">
          {g.servicios.map((s) => (
            <li class="tarjeta">
              <span class="tarjeta__icono"><Icono nombre={s.icono} tamano={20} /></span>
              <h3><a href={`/servicios/${s.slug}/`}>{s.nombre}</a></h3>
              <p>{s.descripcion_corta}</p>
              <span class="tarjeta__mas" aria-hidden="true">Ver detalle</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>

<style>
  .cabecera {
    background: var(--azul-tinta);
    color: var(--papel);
    padding-block: var(--e-12) var(--e-16);
  }
  .entrada {
    font-size: var(--t-lg);
    color: rgba(245, 241, 232, .78);
    max-width: 52ch;
    margin-top: var(--e-4);
  }
  .atajos { display: flex; flex-wrap: wrap; gap: var(--e-2); margin-top: var(--e-8); }
  .atajos a {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    font-size: var(--t-xs);
    font-weight: 600;
    text-decoration: none;
    padding: var(--e-2) var(--e-3);
    border: 1px solid rgba(245, 241, 232, .22);
    border-radius: var(--radio);
    transition: border-color .18s ease, background-color .18s ease;
  }
  .atajos a:hover { border-color: var(--dorado); background: rgba(201, 162, 39, .12); }
  .atajos span { color: var(--dorado-claro); font-variant-numeric: tabular-nums; }

  .grupo { padding-block: var(--e-12); }
  .grupo:nth-child(odd) { background: var(--papel-puro); }
  .grupo h2 { margin-bottom: var(--e-6); }

  .rejilla {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--e-4);
  }
  .tarjeta {
    position: relative;
    display: grid;
    gap: var(--e-2);
    padding: var(--e-6);
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio-lg);
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .grupo:nth-child(odd) .tarjeta { background: var(--papel); }
  .tarjeta:hover {
    transform: translateY(-2px);
    border-color: var(--dorado);
    box-shadow: 0 6px 20px rgba(11, 37, 69, .09);
  }
  .tarjeta__icono {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radio);
    background: var(--dorado-tenue);
    border: 1px solid rgba(201, 162, 39, .32);
    color: var(--azul-tinta);
    transition: background-color .3s ease, color .3s ease, transform .35s cubic-bezier(.34,1.3,.5,1);
  }
  .tarjeta:hover .tarjeta__icono {
    background: var(--azul-tinta);
    color: var(--dorado-claro);
    transform: scale(1.08) rotate(-3deg);
  }
  .tarjeta h3 { font-size: var(--t-md); }
  .tarjeta h3 a { text-decoration: none; }
  .tarjeta h3 a::after { content: ''; position: absolute; inset: 0; }
  .tarjeta p { font-size: var(--t-sm); color: var(--tinta-suave); }
  .tarjeta__mas {
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--azul-medio);
    opacity: 0;
    transition: opacity .2s ease;
  }
  .tarjeta:hover .tarjeta__mas { opacity: 1; }
</style>
