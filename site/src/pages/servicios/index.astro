---
import Base from '../../layouts/Base.astro';
import { SERVICIOS } from '../../datos/servicios.js';
---
<Base
  titulo="Servicios de afiliación a seguridad social | Asesorías SAS"
  descripcion="Afiliación a EPS, ARL, pensión y caja de compensación para independientes y empresas. Traslados y gestión mensual de planilla en toda Colombia."
  ruta="/servicios/"
>
  <section class="cabecera">
    <div class="contenedor">
      <h1>Servicios</h1>
      <p class="entrada">
        Gestionamos tus afiliaciones y tu planilla mensual. Elige el trámite que
        necesitas y te contamos cómo funciona.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <ul class="rejilla">
        {SERVICIOS.map((s) => (
          <li class="tarjeta">
            <h2><a href={`/servicios/${s.slug}/`}>{s.titulo}</a></h2>
            <p>{s.entrada}</p>
            <span class="tarjeta__mas" aria-hidden="true">Ver detalle →</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .cabecera {
    background: var(--azul-tinta);
    color: var(--papel);
    padding-block: var(--e-12) var(--e-16);
  }
  .entrada {
    font-size: var(--t-lg);
    color: rgba(245, 241, 232, .76);
    max-width: 52ch;
    margin-top: var(--e-4);
  }

  .rejilla {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 1px;
    background: var(--linea);
    border: 1px solid var(--linea);
    border-radius: var(--radio-lg);
    overflow: hidden;
  }
  .tarjeta {
    background: var(--papel-puro);
    padding: var(--e-8) var(--e-6);
    display: flex;
    flex-direction: column;
    gap: var(--e-3);
    transition: background-color .18s ease;
  }
  .tarjeta:hover { background: var(--dorado-tenue); }
  .tarjeta h2 { font-size: var(--t-lg); }
  .tarjeta h2 a { text-decoration: none; }
  .tarjeta h2 a::after { content: ''; position: absolute; inset: 0; }
  .tarjeta { position: relative; }
  .tarjeta p { font-size: var(--t-sm); color: var(--tinta-suave); }
  .tarjeta__mas {
    margin-top: auto;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--azul-medio);
  }
</style>
