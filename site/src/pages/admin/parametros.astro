---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout titulo="Parámetros" activo="parametros">
  <div class="cabecera"><h1>Parámetros</h1></div>
  <p class="sub">Al guardar, el valor entra a la base al instante. Para verlo en el sitio, pulsa <strong>Publicar cambios</strong> arriba (reconstruye el sitio).</p>
  <div id="grupos"><div class="cargando">Cargando parámetros…</div></div>

  <style>
    .grupo { margin-bottom: 1.6rem; }
    .grupo > h2 { font-family: var(--serif); font-size: 1.25rem; color: var(--navy); margin: 0 0 .2rem; }
    .grupo > .desc { color: var(--muted); margin: 0 0 .8rem; font-size: .92rem; }
    .param { display: grid; grid-template-columns: 1fr 200px auto; gap: .8rem; align-items: center;
      padding: .6rem 0; border-bottom: 1px solid var(--line); }
    .param:last-child { border-bottom: 0; }
    .param .nom { font-weight: 600; }
    .param .nom small { display: block; font-weight: 400; color: var(--muted); font-size: .8rem; }
    .param .ok { color: var(--ok); font-weight: 600; }
    @media (max-width: 620px) { .param { grid-template-columns: 1fr; } }
  </style>
  <script src="../../scripts/panel-parametros.js"></script>
</AdminLayout>
