---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout titulo="Leads" activo="leads">
  <div class="cabecera"><h1>Leads</h1><span id="conteo" class="pill">—</span></div>
  <p class="sub" id="kpis">Cargando…</p>

  <div class="filtros">
    <input type="search" id="q" placeholder="Buscar por nombre, teléfono o email" />
    <select id="f-estado"><option value="">Todos los estados</option></select>
  </div>

  <div id="tabla-wrap">
    <table>
      <thead><tr>
        <th>Nombre</th><th>Teléfono</th><th>Servicio</th><th>Origen</th><th>Estado</th><th>Fecha</th>
      </tr></thead>
      <tbody id="filas"><tr><td colspan="6" class="cargando">Cargando leads…</td></tr></tbody>
    </table>
  </div>

  <aside id="detalle" hidden></aside>
  <div id="velo" hidden></div>

  <style>
    .filtros { display: flex; gap: .75rem; margin: 0 0 1.1rem; flex-wrap: wrap; }
    .filtros #q { flex: 1; min-width: 220px; }
    .filtros select { width: auto; }
    #velo { position: fixed; inset: 0; background: rgba(22,39,63,.35); z-index: 25; }
    #detalle { position: fixed; top: 0; right: 0; width: min(440px, 100%); height: 100%; overflow: auto;
      background: var(--paper); border-left: 1px solid var(--line); box-shadow: -12px 0 30px rgba(22,39,63,.18);
      z-index: 26; padding: 1.4rem; }
    #detalle h2 { font-family: var(--serif); margin: .2rem 0 .1rem; }
    #detalle .cerrar { float: right; }
    #detalle .dato { color: var(--muted); margin: .1rem 0; }
    #detalle .adjunto { background: #faf6ec; border: 1px solid var(--line); border-radius: 8px; padding: .6rem .8rem; margin: .8rem 0; font-size: .92rem; }
    #detalle ul { padding-left: 1.1rem; color: var(--muted); font-size: .9rem; }
    .est-nuevo { color: #1f5e8a; } .est-contactado { color: #7a5a00; }
    .est-cotizado { color: #6a3fb0; } .est-cerrado { color: var(--ok); } .est-perdido { color: var(--danger); }
  </style>
  <script src="../../scripts/panel-leads.js"></script>
</AdminLayout>
