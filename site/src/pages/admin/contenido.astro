---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout titulo="Contenido" activo="contenido">
  <div class="cabecera"><h1>Contenido</h1></div>
  <p class="sub">Edita lo que se ve en el sitio. Guarda cada tarjeta por separado; luego pulsa <strong>Publicar cambios</strong> para reflejarlo en el sitio.</p>

  <div class="barra-rec">
    <div id="tabs" class="tabs"></div>
    <button class="acc" id="nuevo" hidden>+ Nuevo</button>
  </div>

  <div id="lista"><div class="cargando">Cargando…</div></div>

  <style>
    .barra-rec { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.1rem; flex-wrap: wrap; }
    .tabs { display: inline-flex; background: #ece5d6; border-radius: 10px; padding: 4px; gap: 2px; }
    .tabs button { border: 0; background: transparent; color: var(--muted); font: 600 .9rem var(--sans);
      padding: .45rem .9rem; border-radius: 7px; cursor: pointer; }
    .tabs button.on { background: var(--card); color: var(--navy); box-shadow: var(--sombra); }
    .item h3 { font-family: var(--serif); font-size: 1.15rem; margin: 0 0 .1rem; color: var(--navy); }
    .item .clave-id { color: var(--muted); font-size: .8rem; margin-bottom: .8rem; }
    .item.inactivo { opacity: .62; }
    .item .badge-off { font-size: .72rem; color: var(--danger); border: 1px solid #e6c4c4; border-radius: 999px; padding: .05rem .5rem; margin-left: .5rem; }
    .nuevo-card { border: 1px dashed var(--navy-soft); background: #fbf8f0; }
  </style>
  <script src="../../scripts/panel-contenido.js"></script>
</AdminLayout>
