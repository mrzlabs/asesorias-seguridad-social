---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout titulo="Inicio" activo="inicio">
  <div class="cabecera"><h1>Panel de administración</h1></div>
  <p class="sub">Gestiona leads, contenido del sitio y parámetros de cálculo. Los cambios se guardan al instante, pero solo aparecen en el sitio cuando pulsas <strong>Publicar cambios</strong>.</p>

  <div id="kpis" class="tarjeta"><span class="cargando">Cargando resumen…</span></div>

  <div class="rejilla">
    <a class="tarjeta enlace" href="/admin/leads/">
      <h3>Leads</h3><p>Contactos entrantes, estados y notas de gestión.</p><span class="ir">Abrir →</span>
    </a>
    <a class="tarjeta enlace" href="/admin/contenido/">
      <h3>Contenido</h3><p>Servicios, preguntas frecuentes, testimonios y promociones.</p><span class="ir">Abrir →</span>
    </a>
    <a class="tarjeta enlace" href="/admin/parametros/">
      <h3>Parámetros</h3><p>Salario mínimo, tasas de cotización y datos de contacto.</p><span class="ir">Abrir →</span>
    </a>
  </div>

  <style>
    .rejilla { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; margin-top: 1rem; }
    a.enlace { text-decoration: none; color: inherit; display: flex; flex-direction: column; transition: transform .12s, box-shadow .12s; }
    a.enlace:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(22,39,63,.12); }
    a.enlace h3 { font-family: var(--serif); margin: 0 0 .3rem; font-size: 1.25rem; color: var(--navy); }
    a.enlace p { margin: 0; color: var(--muted); flex: 1; }
    a.enlace .ir { margin-top: .8rem; color: var(--gold); font-weight: 600; }
    #kpis .fila { display: flex; flex-wrap: wrap; gap: 1.5rem; }
    #kpis .kpi { min-width: 90px; }
    #kpis .kpi b { display: block; font-family: var(--serif); font-size: 1.8rem; color: var(--navy); line-height: 1; }
    #kpis .kpi span { color: var(--muted); font-size: .85rem; }
  </style>
  <script src="../../scripts/panel-inicio.js"></script>
</AdminLayout>
