  'heart-pulse': [], 'car': [{ cx: 7, cy: 17, r: 2 }, { cx: 17, cy: 17, r: 2 }],
  'users': [{ cx: 9, cy: 7, r: 4 }],
};

const RECTANGULOS = {
  'calculator': [{ x: 4, y: 2, w: 16, h: 20, rx: 2 }],
};

const trazos = TRAZOS[nombre] || TRAZOS['message-circle'];
const circulos = CIRCULOS[nombre] || [];
const rects = RECTANGULOS[nombre] || [];
---
<svg
  class="icono"
  width={tamano} height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height={r.h} rx={r.rx} />)}
  {trazos.map((d) => <path d={d} />)}
  {circulos.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
</svg>

<style>
  .icono { display: block; flex-shrink: 0; }
</style>
