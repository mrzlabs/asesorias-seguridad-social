---
import { obtenerServicios } from '../datos/servicios.js';
import { obtenerContenido } from '../datos/api.js';
const SERVICIOS = (await obtenerServicios()).slice(0, 8);
const cfg = (await obtenerContenido()).config || {};
const correo = cfg.email_contacto || '';
const slogan = cfg.empresa_slogan || '';
const horario = cfg.horario_atencion || '';
// Negocio de area de servicio: no se muestra direccion de calle (seria
// inconsistente con la ficha de Google, que la oculta). Se muestra la zona
// de atencion y se enlaza la ficha.
const perfilGoogle = 'https://share.google/GZXbFMpyWnsD3GvGC';
const anio = new Date().getFullYear();
---
<footer class="pie">
  <div class="contenedor pie__in">
    <div>
      <div class="pie__marca">Asesorías Seguridad Social SAS</div>
      <p class="pie__desc">
        {slogan || 'Afiliaciones y trámites de seguridad social en toda Colombia.'}
        {correo && <><br /><a class="pie__correo" href={`mailto:${correo}`}>{correo}</a></>}
      </p>
    </div>

    <nav aria-label="Servicios">
      <h2 class="pie__tit">Servicios</h2>
      <ul class="pie__lista">
        {SERVICIOS.map((s) => (
          <li><a href={`/servicios/${s.slug}/`}>{s.nombre}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="pie__tit">Contacto</h2>
      <ul class="pie__lista">
        <li><a href="tel:+573204060607">+57 320 406 0607</a></li>
        <li><a href="tel:+573134572362">+57 313 457 2362</a></li>
        {correo && <li><a href={`mailto:${correo}`}>{correo}</a></li>}
        <li><a href={perfilGoogle} rel="noopener" target="_blank">Reseñas en Google</a></li>
        <li><a href="https://www.facebook.com/Colombiasesorias" rel="noopener">Facebook</a></li>
      </ul>
      <p class="pie__extra">
        Atención en línea en toda Colombia.
        {horario && <><br />{horario}</>}
      </p>

      <h2 class="pie__tit pie__tit--sep">Legal</h2>
      <ul class="pie__lista">
        <li><a href="/legal/politica-de-datos/">Tratamiento de datos</a></li>
        <li><a href="/legal/terminos/">Términos y condiciones</a></li>
      </ul>
    </div>
  </div>

  <div class="pie__base">
    <div class="contenedor pie__base-in">
      <span>© {anio} Asesorías Seguridad Social SAS · Colombia</span>
      <!-- mailto mientras no exista sitio propio: un enlace a un dominio
           inexistente es peor que ninguno. -->
      <a class="firma" href="mailto:contacto@mrzlabs.anonaddy.com">
        <span class="firma__marca" aria-hidden="true">&lt;/&gt;</span>
        <span class="firma__txt">
          Desarrollado por <strong>MrzLabs</strong>
          <span class="firma__correo">contacto@mrzlabs.anonaddy.com</span>
        </span>
      </a>
    </div>
  </div>
</footer>

<style>
  .pie {
    background: var(--azul-tinta);
    color: rgba(245, 241, 232, .72);
    /* Sin margen superior: el aire lo aporta el padding de la ultima
       seccion. Un margen aqui abriria una banda clara entre el pie y
       cualquier seccion oscura que lo preceda. */
  }
  .pie__in {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--e-12);
    padding-block: var(--e-16) var(--e-12);
  }
  .pie__marca {
    font-family: var(--fuente-titulo);
    font-size: var(--t-lg);
    color: var(--papel);
    margin-bottom: var(--e-3);
  }
  .pie__desc { font-size: var(--t-sm); max-width: 36ch; }
  .pie__correo {
    display: inline-block;
    margin-top: var(--e-2);
    color: var(--dorado-claro);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color .25s ease;
  }
  .pie__correo:hover { border-bottom-color: var(--dorado-claro); }
  .pie__tit {
    font-family: var(--fuente-texto);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--dorado-claro);
    margin-bottom: var(--e-4);
  }
  .pie__extra {
    margin-top: var(--e-3);
    font-size: var(--t-xs);
    line-height: 1.6;
    color: rgba(245, 241, 232, .48);
  }
  .pie__tit--sep { margin-top: var(--e-6); }
  .pie__lista { list-style: none; display: grid; gap: var(--e-2); font-size: var(--t-sm); }
  .pie__lista a { text-decoration: none; }
  .pie__lista a:hover { color: var(--papel); text-decoration: underline; }

  .pie__base {
    border-top: 1px solid rgba(245, 241, 232, .10);
    padding-block: var(--e-4);
    font-size: var(--t-xs);
  }
  .pie__base-in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--e-4);
    flex-wrap: wrap;
  }

  .firma {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    text-decoration: none;
    color: rgba(245, 241, 232, .5);
    transition: color .28s ease;
  }
  .firma__marca {
    display: grid;
    place-items: center;
    width: 22px; height: 22px;
    border-radius: 4px;
    background: rgba(245, 241, 232, .08);
    border: 1px solid rgba(245, 241, 232, .14);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    color: var(--dorado-claro);
    transition: background-color .28s ease, border-color .28s ease, transform .34s cubic-bezier(.34,1.3,.5,1);
  }
  .firma__txt { display: inline-flex; align-items: baseline; gap: var(--e-2); flex-wrap: wrap; }
  .firma strong { font-weight: 600; }
  .firma__correo {
    color: rgba(245, 241, 232, .34);
    transition: color .28s ease;
  }
  .firma:hover .firma__correo { color: var(--dorado-claro); }
  .firma:hover { color: var(--papel); }
  .firma:hover .firma__marca {
    background: var(--dorado);
    border-color: var(--dorado);
    color: var(--azul-tinta);
    transform: rotate(-6deg) scale(1.08);
  }

  @media (max-width: 760px) {
    .pie__in { grid-template-columns: 1fr; gap: var(--e-8); }
  }
</style>
