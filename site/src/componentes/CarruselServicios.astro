---
// Los 24 servicios en una pista horizontal, filtrables por categoria.
const { grupos = [] } = Astro.props;
const todos = grupos.flatMap((g) => g.servicios.map((s) => ({ ...s, _grupo: g.etiqueta })));
---
<div class="carr">
  <div class="carr__barra">
    <div class="carr__chips" role="group" aria-label="Filtrar servicios por categoría">
      <button type="button" class="carr__chip es-activo" data-cat="todas">
        Todos <span>{todos.length}</span>
      </button>
      {grupos.map((g) => (
        <button type="button" class="carr__chip" data-cat={g.clave}>
          {g.etiqueta} <span>{g.servicios.length}</span>
        </button>
      ))}
    </div>

    <div class="carr__flechas">
      <button type="button" class="carr__fl" id="carrIzq" aria-label="Anterior">←</button>
      <button type="button" class="carr__fl" id="carrDer" aria-label="Siguiente">→</button>
    </div>
  </div>

  <ul class="carr__pista" id="carrPista">
    {todos.map((s) => (
      <li class="carr__item" data-cat={s.categoria}>
        <a class="carr__tarjeta" href={`/servicios/${s.slug}/`}>
          <span class="carr__grupo">{s._grupo}</span>
          <span class="carr__nombre">{s.nombre}</span>
          <span class="carr__desc">{s.descripcion_corta}</span>
          <span class="carr__ir" aria-hidden="true">Ver detalle →</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  const carr = document.querySelector('.carr');
  if (carr) {
    const pista = carr.querySelector('#carrPista');
    const items = [...pista.querySelectorAll('.carr__item')];
    const chips = [...carr.querySelectorAll('.carr__chip')];

    chips.forEach((c) => {
      c.addEventListener('click', () => {
        chips.forEach((o) => o.classList.toggle('es-activo', o === c));
        const cat = c.dataset.cat;
        items.forEach((i) => { i.hidden = cat !== 'todas' && i.dataset.cat !== cat; });
        pista.scrollTo({ left: 0, behavior: 'smooth' });
      });
    });

    // Avanza una tarjeta completa, no una cantidad fija de pixeles.
    const salto = () => {
      const visible = items.find((i) => !i.hidden);
      return visible ? visible.getBoundingClientRect().width + 16 : 300;
    };
    carr.querySelector('#carrIzq')
      .addEventListener('click', () => pista.scrollBy({ left: -salto(), behavior: 'smooth' }));
    carr.querySelector('#carrDer')
      .addEventListener('click', () => pista.scrollBy({ left: salto(), behavior: 'smooth' }));

    // Las flechas se apagan en los extremos.
    const actualizar = () => {
      const fin = pista.scrollWidth - pista.clientWidth - 2;
      carr.querySelector('#carrIzq').disabled = pista.scrollLeft <= 2;
      carr.querySelector('#carrDer').disabled = pista.scrollLeft >= fin;
    };
    pista.addEventListener('scroll', actualizar, { passive: true });
    actualizar();
  }
</script>

<style>
  .carr { display: grid; gap: var(--e-4); }

  .carr__barra {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--e-4);
    flex-wrap: wrap;
  }
  .carr__chips { display: flex; flex-wrap: wrap; gap: var(--e-2); }
  .carr__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--fuente-texto);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--tinta-suave);
    background: transparent;
    border: 1px solid var(--linea);
    border-radius: 999px;
    padding: 7px 14px;
    cursor: pointer;
    transition: color .22s ease, border-color .22s ease, background-color .22s ease;
  }
  .carr__chip span { color: var(--tinta-tenue); font-variant-numeric: tabular-nums; }
  .carr__chip:hover { border-color: var(--dorado); color: var(--tinta); }
  .carr__chip.es-activo {
    background: var(--azul-tinta);
    border-color: var(--azul-tinta);
    color: var(--papel);
  }
  .carr__chip.es-activo span { color: var(--dorado-claro); }

  .carr__flechas { display: flex; gap: var(--e-2); }
  .carr__fl {
    width: 38px; height: 38px;
    border: 1px solid var(--linea);
    border-radius: 50%;
    background: var(--papel-puro);
    color: var(--azul-tinta);
    font-size: 15px;
    cursor: pointer;
    transition: background-color .22s ease, border-color .22s ease, opacity .22s ease;
  }
  .carr__fl:hover:not(:disabled) { background: var(--azul-tinta); color: var(--papel); border-color: var(--azul-tinta); }
  .carr__fl:disabled { opacity: .32; cursor: default; }

  .carr__pista {
    list-style: none;
    display: flex;
    gap: var(--e-4);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding: var(--e-2) var(--e-1) var(--e-6);
    scrollbar-width: thin;
  }
  .carr__pista::-webkit-scrollbar { height: 6px; }
  .carr__pista::-webkit-scrollbar-thumb { background: var(--linea); border-radius: 999px; }
  .carr__pista::-webkit-scrollbar-thumb:hover { background: var(--dorado); }

  .carr__item { flex: 0 0 clamp(238px, 25vw, 290px); scroll-snap-align: start; }

  .carr__tarjeta {
    position: relative;
    display: grid;
    gap: var(--e-2);
    height: 100%;
    padding: var(--e-6);
    background: var(--papel-puro);
    border: 1px solid var(--linea);
    border-radius: var(--radio-lg);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform .4s cubic-bezier(.22, .78, .3, 1),
      box-shadow .4s cubic-bezier(.22, .78, .3, 1),
      border-color .4s ease;
  }
  /* Franja superior que se despliega desde la izquierda al enfocar. */
  .carr__tarjeta::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--dorado);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .42s cubic-bezier(.22, .78, .3, 1);
  }
  .carr__tarjeta:hover,
  .carr__tarjeta:focus-visible {
    transform: translateY(-5px);
    border-color: var(--dorado);
    box-shadow: 0 16px 36px rgba(11, 37, 69, .14);
  }
  .carr__tarjeta:hover::before,
  .carr__tarjeta:focus-visible::before { transform: scaleX(1); }

  .carr__grupo {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--tinta-tenue);
  }
  .carr__nombre { font-family: var(--fuente-titulo); font-size: var(--t-md); font-weight: 600; }
  .carr__desc { font-size: var(--t-sm); color: var(--tinta-suave); }
  .carr__ir {
    margin-top: auto;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--azul-medio);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity .3s ease, transform .36s cubic-bezier(.22, .78, .3, 1);
  }
  .carr__tarjeta:hover .carr__ir,
  .carr__tarjeta:focus-visible .carr__ir { opacity: 1; transform: translateX(0); }

  @media (prefers-reduced-motion: reduce) {
    .carr__tarjeta, .carr__tarjeta::before, .carr__ir { transition: none; }
    .carr__tarjeta:hover { transform: none; }
  }

  @media (max-width: 640px) {
    .carr__flechas { display: none; }
  }
</style>
