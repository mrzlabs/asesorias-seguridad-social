---
// Shell compartido del panel de administración: barra de navegación siempre
// presente, tokens de diseño y estilos de tarjetas/formularios/tablas.
// Acceso keyless: las páginas van detrás de Cloudflare Access; la API se llama
// same-origin a /admin/api/* con la cookie de Access.
const { titulo = 'Panel', activo = '' } = Astro.props;
const nav = [
  { id: 'leads', href: '/admin/leads/', etiqueta: 'Leads' },
  { id: 'contenido', href: '/admin/contenido/', etiqueta: 'Contenido' },
  { id: 'eps', href: '/admin/eps/', etiqueta: 'EPS y ciudades' },
  { id: 'parametros', href: '/admin/parametros/', etiqueta: 'Parámetros' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Panel Asesorías</title>
    <style is:global>
      :root {
        --navy: #16273f; --navy-soft: #223a5e; --gold: #c1932f; --gold-soft: #e7d5a6;
        --paper: #f5f1e8; --card: #fffdf8; --ink: #1e222b; --muted: #726c60;
        --line: #e5ddcc; --ok: #2f7d4f; --danger: #b23b3b;
        --serif: Georgia, 'Iowan Old Style', 'Times New Roman', serif;
        --sans: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        --radio: 10px; --sombra: 0 1px 2px rgba(22,39,63,.06), 0 8px 24px rgba(22,39,63,.06);
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans);
        font-size: 15px; line-height: 1.55; }
      a { color: var(--navy-soft); }

      /* Barra superior */
      .barra { position: sticky; top: 0; z-index: 20; background: var(--navy); color: #fff;
        display: flex; align-items: center; gap: 1.5rem; padding: 0 1.25rem; height: 60px;
        box-shadow: 0 1px 0 rgba(0,0,0,.15); }
      .marca { font-family: var(--serif); font-size: 1.15rem; letter-spacing: .2px; white-space: nowrap; }
      .marca b { color: var(--gold-soft); font-weight: 400; }
      .barra nav { display: flex; gap: .25rem; margin-left: .5rem; flex: 1; }
      .barra nav a { color: #cfd6e2; text-decoration: none; padding: .45rem .8rem; border-radius: 7px;
        font-weight: 500; transition: background .15s, color .15s; }
      .barra nav a:hover { background: rgba(255,255,255,.08); color: #fff; }
      .barra nav a[aria-current="page"] { color: var(--navy); background: var(--gold-soft); }
      .btn-publicar { background: var(--gold); color: #241c00; border: 0; border-radius: 7px;
        font: 600 .92rem var(--sans); padding: .5rem 1rem; cursor: pointer; white-space: nowrap; }
      .btn-publicar:hover { filter: brightness(1.05); }
      .btn-publicar:disabled { opacity: .6; cursor: default; }

      main { max-width: 1080px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      .cabecera { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
        flex-wrap: wrap; margin-bottom: .5rem; }
      h1 { font-family: var(--serif); font-weight: 600; font-size: 1.9rem; margin: 0; letter-spacing: -.3px; }
      .sub { color: var(--muted); margin: .1rem 0 1.5rem; }

      /* Avisos */
      #banner { display: none; margin: 0 0 1.25rem; padding: .8rem 1rem; border-radius: var(--radio);
        border: 1px solid; }
      #banner.err { display: block; background: #fbecec; border-color: #e6bcbc; color: #7c2626; }
      #banner.ok { display: block; background: #eaf5ee; border-color: #b9dcc6; color: #1f5e3a; }
      .toast { position: fixed; right: 1.25rem; bottom: 1.25rem; background: var(--navy); color: #fff;
        padding: .7rem 1.1rem; border-radius: 8px; box-shadow: var(--sombra); opacity: 0;
        transform: translateY(8px); transition: .25s; pointer-events: none; z-index: 30; }
      .toast.ver { opacity: 1; transform: none; }

      /* Tarjetas y formularios */
      .tarjeta { background: var(--card); border: 1px solid var(--line); border-radius: var(--radio);
        box-shadow: var(--sombra); padding: 1.1rem 1.2rem; margin-bottom: 1rem; }
      .campo { margin-bottom: .85rem; }
      .campo:last-child { margin-bottom: 0; }
      label.et { display: block; font-size: .78rem; text-transform: uppercase; letter-spacing: .06em;
        color: var(--muted); font-weight: 600; margin-bottom: .28rem; }
      input[type=text], input[type=number], input[type=search], input[type=password], textarea, select {
        width: 100%; font: inherit; color: inherit; background: #fff; border: 1px solid var(--line);
        border-radius: 8px; padding: .55rem .7rem; transition: border-color .15s, box-shadow .15s; }
      input:focus, textarea:focus, select:focus { outline: none; border-color: var(--navy-soft);
        box-shadow: 0 0 0 3px rgba(34,58,94,.12); }
      textarea { min-height: 4.5rem; resize: vertical; }
      .cols2 { display: grid; grid-template-columns: 1fr 1fr; gap: .85rem; }
      @media (max-width: 620px) { .cols2 { grid-template-columns: 1fr; } .barra { gap: .5rem; } .barra .marca { display: none; } }

      button.acc { font: 600 .9rem var(--sans); border: 0; border-radius: 8px; padding: .5rem 1rem;
        cursor: pointer; background: var(--navy); color: #fff; }
      button.acc:hover { background: var(--navy-soft); }
      button.acc.sec { background: transparent; color: var(--navy-soft); border: 1px solid var(--line); }
      button.acc.peligro { background: transparent; color: var(--danger); border: 1px solid #e6c4c4; }
      button.acc:disabled { opacity: .55; cursor: default; }
      .fila-acc { display: flex; align-items: center; gap: .7rem; margin-top: .9rem; flex-wrap: wrap; }
      .interruptor { display: inline-flex; align-items: center; gap: .45rem; font-size: .9rem; color: var(--muted); }

      table { width: 100%; border-collapse: collapse; background: var(--card); border-radius: var(--radio);
        overflow: hidden; box-shadow: var(--sombra); }
      thead th { text-align: left; font-size: .74rem; text-transform: uppercase; letter-spacing: .06em;
        color: var(--muted); padding: .7rem .9rem; border-bottom: 1px solid var(--line); background: #faf6ec; }
      tbody td { padding: .7rem .9rem; border-bottom: 1px solid var(--line); }
      tbody tr:last-child td { border-bottom: 0; }
      tbody tr.click { cursor: pointer; }
      tbody tr.click:hover { background: #faf6ec; }
      .pill { display: inline-block; font-size: .78rem; font-weight: 600; padding: .15rem .55rem;
        border-radius: 999px; border: 1px solid var(--line); }
      .cargando { color: var(--muted); padding: 2rem 0; text-align: center; }
    </style>
  </head>
  <body>
    <header class="barra">
      <a href="/admin/" class="marca" style="text-decoration:none;color:inherit">Panel <b>Asesorías</b></a>
      <nav>
        {nav.map((n) => (
          <a href={n.href} aria-current={activo === n.id ? 'page' : undefined}>{n.etiqueta}</a>
        ))}
      </nav>
      <button class="btn-publicar" id="publicar" title="Reconstruye el sitio con los cambios guardados">Publicar cambios</button>
    </header>
    <main>
      <div id="banner" role="alert"></div>
      <slot />
    </main>
    <div class="toast" id="toast"></div>
    <script src="../scripts/panel-barra.js"></script>
  </body>
</html>
