---
import Base from './Base.astro';
const { titulo, descripcion, ruta, actualizado } = Astro.props;
---
<Base titulo={titulo} descripcion={descripcion} ruta={ruta}>
  <section class="legal-cab">
    <div class="contenedor">
      <nav class="miga" aria-label="Ruta de navegación">
        <a href="/">Inicio</a> <span aria-hidden="true">/</span>
        <span aria-current="page">Legal</span>
      </nav>
      <h1><slot name="titulo" /></h1>
      <p class="legal-fecha">Última actualización: {actualizado}</p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <article class="legal">
        <slot />
      </article>
    </div>
  </section>
</Base>

<style is:global>
  .legal-cab {
    background: var(--azul-tinta);
    color: var(--papel);
    padding-block: var(--e-8) var(--e-12);
  }
  .legal-cab .miga { font-size: var(--t-xs); color: rgba(245, 241, 232, .55); margin-bottom: var(--e-6); }
  .legal-cab .miga a { color: rgba(245, 241, 232, .78); text-decoration: none; }
  .legal-cab h1 { max-width: 22ch; }
  .legal-fecha { font-size: var(--t-sm); color: rgba(245, 241, 232, .6); margin-top: var(--e-3); }

  .legal { max-width: 72ch; }
  .legal h2 {
    font-size: var(--t-lg);
    margin-top: var(--e-12);
    margin-bottom: var(--e-3);
    padding-top: var(--e-6);
    border-top: 1px solid var(--linea);
  }
  .legal h2:first-child { margin-top: 0; padding-top: 0; border-top: none; }
  .legal h3 { font-size: var(--t-md); margin-top: var(--e-6); margin-bottom: var(--e-2); }
  .legal p { margin-bottom: var(--e-4); color: var(--tinta-suave); }
  .legal ul, .legal ol { margin: 0 0 var(--e-4) var(--e-6); color: var(--tinta-suave); }
  .legal li { margin-bottom: var(--e-2); }
  .legal strong { color: var(--tinta); }
  .legal a { color: var(--azul-medio); }
  .legal .dato {
    background: var(--papel-puro);
    border: 1px solid var(--linea);
    border-left: 3px solid var(--dorado);
    border-radius: var(--radio);
    padding: var(--e-4) var(--e-6);
    margin-bottom: var(--e-6);
  }
  .legal .dato p:last-child { margin-bottom: 0; }
</style>
